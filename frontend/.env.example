# Weather API - 기상청 API (추천) 또는 OpenWeatherMap
# 기상청 API: https://www.data.go.kr/tcs/dss/selectApiDataDetailView.do?publicDataPk=15084084
VITE_KMA_API_KEY=your_kma_api_key_here

# AirKorea API (미세먼지 정보) - 기상청 API와 함께 사용
# AirKorea API: https://www.data.go.kr/tcs/dss/selectApiDataDetailView.do?publicDataPk=15073861
VITE_AIRKOREA_API_KEY=your_airkorea_api_key_here

# OpenWeatherMap API (기상청 API가 없을 경우 - 날씨+미세먼지 모두 제공)
# Get your API key from: https://openweathermap.org/api
VITE_WEATHER_API_KEY=your_openweathermap_api_key_here

# Transit API (공공데이터포털)
# Get your API key from: https://www.data.go.kr/
VITE_TRANSIT_API_KEY=your_transit_api_key_here
