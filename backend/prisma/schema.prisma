// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id          String    @id @default(uuid())
  email       String?   @unique
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  routines    Routine[]
  preferences UserPreferences?

  @@map("users")
}

model UserPreferences {
  id        String   @id @default(uuid())
  userId    String   @unique
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  timezone  String   @default("Asia/Seoul")
  language  String   @default("ko")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("user_preferences")
}

model Routine {
  id                String   @id @default(uuid())
  userId            String
  user              User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  name              String
  scheduleTime      String   // HH:mm 형식
  daysOfWeek        Int[]    // 0=일요일, 6=토요일
  enabled           Boolean  @default(true)
  notificationTime  String   // 알림 시간 (HH:mm)
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt
  informationSources InformationSource[]

  @@map("routines")
}

model InformationSource {
  id        String   @id @default(uuid())
  routineId String
  routine   Routine  @relation(fields: [routineId], references: [id], onDelete: Cascade)
  type      String   // 'weather', 'airQuality', 'bus', 'subway'
  config    Json     // 타입별 설정 정보
  order     Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("information_sources")
}

model NotificationHistory {
  id          String   @id @default(uuid())
  userId      String
  routineId   String?
  type        String
  title       String
  message     String
  sentAt      DateTime @default(now())
  read        Boolean  @default(false)

  @@map("notification_history")
}
